###
# Complete API Test Coverage
# Tests all fixed controller routes matching the scenarios
#

@server = http://127.0.0.1:3000
@adminuser = admin
@adminpassword = admin

###
### AUTHENTICATION TESTS
###

## Login as admin
# @name admin_login
POST {{server}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "{{adminuser}}",
  "password": "{{adminpassword}}"
}

###
### FIELDS ROUTES TESTS
### Testing: GET /fields, GET /fields/:id, POST /fields, PUT /fields/:id
###

## Get all fields (PUBLIC)
GET {{server}}/fields HTTP/1.1

###
## Get field by ID (PUBLIC)
GET {{server}}/fields/1 HTTP/1.1

###
## Create new field (ADMIN ONLY)
# @name newfield
POST {{server}}/fields HTTP/1.1
Content-Type: application/json
Authorization: {{admin_login.response.body.token}}

{
  "name": "Test Field A",
  "location": "Test Location"
}

###
## Update field (ADMIN ONLY)
PUT {{server}}/fields/{{newfield.response.body.id}} HTTP/1.1
Content-Type: application/json
Authorization: {{admin_login.response.body.token}}

{
  "id": {{newfield.response.body.id}},
  "name": "Test Field A Updated",
  "location": "Updated Location"
}

###
## Delete field (ADMIN ONLY)
DELETE {{server}}/fields/{{newfield.response.body.id}} HTTP/1.1
Authorization: {{admin_login.response.body.token}}

